---
import '@fontsource-variable/fraunces/full.css';
import '@fontsource-variable/fraunces/full-italic.css';
import '@fontsource-variable/bricolage-grotesque/standard.css';
import '../styles/global.css';
import { ClientRouter } from 'astro:transitions';
import { SITE } from '../site';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  /** which nav item is current */
  section?: 'stream' | 'photos' | 'map' | 'archive' | 'about';
}

const { title, description = SITE.description, image, section } = Astro.props;
const fullTitle = title ? `${title} — ${SITE.name}` : SITE.name;
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = image ? new URL(image, Astro.site).href : undefined;

const nav: { href: string; label: string; key: NonNullable<Props['section']> }[] = [
  { href: '/', label: 'stream', key: 'stream' },
  { href: '/photos', label: 'photos', key: 'photos' },
  { href: '/map', label: 'map', key: 'map' },
  { href: '/archive', label: 'archive', key: 'archive' },
  { href: '/about', label: 'about', key: 'about' },
];
---

<!doctype html>
<html lang={SITE.lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="alternate" type="application/rss+xml" title={SITE.name} href="/rss.xml" />
    <link rel="alternate" type="application/feed+json" title={SITE.name} href="/feed.json" />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:title" content={title ?? SITE.name} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="en_GB" />
    {ogImage && <meta property="og:image" content={ogImage} />}
    <meta name="twitter:card" content={ogImage ? 'summary_large_image' : 'summary'} />
    <meta name="theme-color" content="#f3f5f9" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0d1530" media="(prefers-color-scheme: dark)" />
    <script is:inline>
      // Apply the saved theme before first paint so nothing flashes.
      (function () {
        try {
          var t = localStorage.getItem('theme');
          if (t === 'light' || t === 'dark') document.documentElement.setAttribute('data-theme', t);
        } catch (e) {}
      })();
    </script>
    <ClientRouter />
    <slot name="head" />
  </head>
  <body>
    <header class="site-header" transition:persist="header">
      <div class="wrap">
        <a class="wordmark" href="/">
          thecurious<b>.online</b>
        </a>
        <nav class="nav" aria-label="Sections">
          {nav.map((n) => (
            <a href={n.href} aria-current={section === n.key ? 'page' : undefined} data-nav={n.key}>
              {n.label}
            </a>
          ))}
        </nav>
        <button type="button" class="theme-toggle" data-theme-toggle aria-label="Switch theme" title="Theme">
          <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true">
            <circle class="sun" cx="12" cy="12" r="4.5" fill="none" stroke="currentColor" stroke-width="1.8"></circle>
            <g class="rays" stroke="currentColor" stroke-width="1.8" stroke-linecap="round">
              <path d="M12 2.5v2.5M12 19v2.5M2.5 12H5M19 12h2.5M5.3 5.3l1.8 1.8M16.9 16.9l1.8 1.8M5.3 18.7l1.8-1.8M16.9 7.1l1.8-1.8"></path>
            </g>
            <path
              class="moon"
              d="M14.5 3.5a8.5 8.5 0 1 0 6 13.2A7 7 0 0 1 14.5 3.5z"
              fill="none"
              stroke="currentColor"
              stroke-width="1.8"
              stroke-linejoin="round"
            ></path>
          </svg>
        </button>
      </div>
    </header>

    <main>
      <div hidden data-section={section ?? ''}></div>
      <div class="wrap">
        <slot />
      </div>
    </main>

    <footer class="site-footer">
      <div class="wrap">
        <a href={SITE.authorUrl}>{SITE.author}</a>
        <a href="/rss.xml">rss</a>
        <a href="/feed.json">json feed</a>
        <a href={SITE.repo}>source</a>
      </div>
    </footer>

    <script>
      // The header persists across client-side navigations (transition:persist),
      // so these handlers are bound once; the per-page work happens in `sync`.
      const root = document.documentElement;
      const header = document.querySelector('.site-header')!;
      const themeButton = header.querySelector<HTMLButtonElement>('[data-theme-toggle]')!;

      function save(key: string, value: string | null) {
        try {
          value === null ? localStorage.removeItem(key) : localStorage.setItem(key, value);
        } catch {}
      }

      function applyTheme(theme: string | null) {
        if (theme) root.setAttribute('data-theme', theme);
        else root.removeAttribute('data-theme');
        const dark = theme === 'dark' || (!theme && matchMedia('(prefers-color-scheme: dark)').matches);
        themeButton.setAttribute('aria-label', dark ? 'Switch to light theme' : 'Switch to dark theme');
      }

      /** Per-page: mark the current nav item and re-apply the theme. */
      function sync() {
        const section = document.querySelector('main [data-section]')?.getAttribute('data-section') ?? '';
        header.querySelectorAll<HTMLAnchorElement>('.nav a').forEach((a) => {
          if (a.dataset.nav === section) a.setAttribute('aria-current', 'page');
          else a.removeAttribute('aria-current');
        });
        applyTheme(root.getAttribute('data-theme'));
      }

      themeButton.addEventListener('click', () => {
        // cycle: system → the opposite of system → the other one → system
        const current = root.getAttribute('data-theme');
        const systemDark = matchMedia('(prefers-color-scheme: dark)').matches;
        let next: string | null;
        if (!current) next = systemDark ? 'light' : 'dark';
        else if (current === 'dark') next = 'light';
        else next = null;
        save('theme', next);
        applyTheme(next);
      });

      // Keep the saved theme on the <html> element after the router swaps it in.
      document.addEventListener('astro:after-swap', () => {
        try {
          const t = localStorage.getItem('theme');
          if (t === 'light' || t === 'dark') root.setAttribute('data-theme', t);
        } catch {}
      });
      document.addEventListener('astro:page-load', sync);
    </script>
  </body>
</html>
