---
import type { GetStaticPaths } from 'astro';
import Single from '../../components/Single.astro';
import { allEntries, isPhoto } from '../../lib/entries';

export const getStaticPaths = (async () => {
  // neighbours are other photos, so the photo page reads as a gallery
  const photos = (await allEntries()).filter(isPhoto);
  return photos.map((item, i) => ({
    params: { id: item.entry.id },
    props: { item, prev: photos[i + 1], next: photos[i - 1] },
  }));
}) satisfies GetStaticPaths;

const { item, prev, next } = Astro.props;
---

<Single item={item} prev={prev} next={next} />
