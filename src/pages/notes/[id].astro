---
import type { GetStaticPaths } from 'astro';
import Single from '../../components/Single.astro';
import { allEntries } from '../../lib/entries';

export const getStaticPaths = (async () => {
  const all = await allEntries();
  return all
    .map((item, i) => ({ item, prev: all[i + 1], next: all[i - 1] }))
    .filter(({ item }) => item.kind === 'note')
    .map(({ item, prev, next }) => ({ params: { id: item.entry.id }, props: { item, prev, next } }));
}) satisfies GetStaticPaths;

const { item, prev, next } = Astro.props;
---

<Single item={item} prev={prev} next={next} />
