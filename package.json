{
  "name": "thecurious",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "thecurious.online — a daily stream of notes, links, photos and the occasional post",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "check": "astro check",
    "note": "node scripts/new.mjs note",
    "link": "node scripts/new.mjs link",
    "post": "node scripts/new.mjs post",
    "photo": "node scripts/photo.mjs",
    "photos:optimize": "node scripts/optimize-photos.mjs",
    "publish": "git add -A && git commit -m \"content: $(date +%F) update\" && git push"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.4",
    "@fontsource-variable/bricolage-grotesque": "^5.3.0",
    "@fontsource-variable/fraunces": "^5.3.0",
    "astro": "^7.4.2",
    "exifr": "^7.1.3",
    "leaflet": "^1.9.4",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@types/leaflet": "^1.9.22",
    "prettier": "^3.9.10",
    "prettier-plugin-astro": "^1.1.2",
    "typescript": "^6.0.3"
  }
}
